// Prisma 스키마: 이 파일 하나가 "테이블 정의 + 타입 생성 + 마이그레이션" 의 출발점이다.
// main 브랜치의 src/lib/schema.ts (SQL 문자열 + 수동 ALTER TABLE) 를 대체한다.
//
// - 모델 이름은 PascalCase 단수(User, Post), 테이블/컬럼 이름은 @@map / @map 으로 기존 snake_case 를 유지한다.
//   그래서 main 브랜치와 같은 data/app.db 파일을 그대로 읽고 쓸 수 있다.
// - 날짜 컬럼은 기존 DB 와 호환되도록 TEXT(String) 로 두고 기본값을 SQLite 의 datetime('now') 로 위임한다.
//   (새로 시작하는 프로젝트라면 DateTime 타입을 쓰는 것이 보통이다)
// - 관계(@relation)를 선언해 두면 `include: { author: true }` 처럼 JOIN 을 코드로 표현할 수 있다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  avatarPath   String?  @map("avatar_path") // 아바타 파일명 (data/uploads/). NULL 이면 없음
  createdAt    String   @default(dbgenerated("(datetime('now'))")) @map("created_at")

  posts         Post[]
  comments      Comment[]
  apiKeys       ApiKey[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Todo {
  id        Int    @id @default(autoincrement())
  title     String
  completed Int    @default(0) // SQLite 에는 boolean 이 없어 0/1. 앱 타입으로 바꿀 때 boolean 으로 변환
  createdAt String @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@map("todos")
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String
  authorId  Int?    @map("author_id")
  imagePath String? @map("image_path")
  createdAt String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt String  @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  author   User?     @relation(fields: [authorId], references: [id])
  comments Comment[]

  @@map("posts")
}

model Comment {
  id        Int    @id @default(autoincrement())
  postId    Int    @map("post_id")
  parentId  Int?   @map("parent_id")
  authorId  Int    @map("author_id")
  content   String
  createdAt String @default(dbgenerated("(datetime('now'))")) @map("created_at")

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Replies")
  author  User      @relation(fields: [authorId], references: [id])

  @@index([postId], map: "idx_comments_post")
  @@map("comments")
}

model ApiKey {
  id         Int     @id @default(autoincrement())
  userId     Int     @map("user_id")
  name       String
  keyHash    String  @unique @map("key_hash")
  prefix     String
  lastUsedAt String? @map("last_used_at")
  revokedAt  String? @map("revoked_at")
  createdAt  String  @default(dbgenerated("(datetime('now'))")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_api_keys_user")
  @@map("api_keys")
}

// 공개 API 의 리프레시 토큰 (main 의 schema.ts refresh_tokens 와 같은 테이블). 자세한 설명은 src/lib/refresh-tokens.ts.
// 액세스 토큰(JWT)과 달리 서버에 저장한다: 행이 있어야 유효하므로 로그아웃·재사용 감지 때 즉시 무효화할 수 있다.
model RefreshToken {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  familyId  String  @map("family_id") // 로그인 한 번 = 가족 하나. 회전으로 만든 새 토큰도 같은 값을 물려받는다
  tokenHash String  @unique @map("token_hash") // 원문은 저장하지 않는다. SHA-256 해시만 (API 키와 같은 원칙)
  expiresAt String  @map("expires_at") // 만료 시각. 가족 전체가 같은 값을 공유한다 (로그인 시점 + 30일, 절대 수명)
  usedAt    String? @map("used_at") // 회전으로 소비된 시각. NULL 이 아닌 토큰이 다시 오면 "재사용" → 가족 전체 폐기
  revokedAt String? @map("revoked_at") // 폐기 시각 (로그아웃, 재사용 감지). NULL 이 아니면 거부
  createdAt String  @default(dbgenerated("(datetime('now'))")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}
