# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# oh-my-claudecode session state
.omc/

# sqlite (학습용 로컬 DB)
/data/*.db
/data/*.db-*

# playwright
/test-results/
/playwright-report/

# 업로드된 이미지 (학습용 로컬 저장소)
/data/uploads/

# prisma generate 산출물 (npm install 시 postinstall 로 다시 생성)
/src/generated/
